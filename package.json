{
  "name": "aureon-public-site",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/generate-seo.mjs && next build && node scripts/finalize-404.mjs",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "node scripts/audit.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "release:check": "node scripts/release-check.mjs",
    "check:export": "node scripts/check-export.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:export"
  },
  "dependencies": {
    "lucide-react": "0.544.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.15.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/three": "0.180.0",
    "typescript": "5.9.3"
  }
}
